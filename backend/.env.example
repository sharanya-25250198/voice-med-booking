# Required API Keys (can also be entered directly in the UI Settings drawer)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Neon PostgreSQL Connection String (falls back to local SQLite if omitted)
DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/dbname?sslmode=require

# Optional STT/TTS Providers
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: External Google Calendar API Integration
GOOGLE_CALENDAR_CREDENTIALS=path/to/credentials.json
GOOGLE_CALENDAR_ID=primary

# Backend Port Configuration
PORT=7500
CRM_PORT=9090
